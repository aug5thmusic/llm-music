\version "2.26.0"
\language "nederlands"
% LANTERNS AT MIDNIGHT: orchestration of the original piano waltz.
% Standalone source; generated by scripts/lanterns-at-midnight/orchestrate.py.
% 104 printed / 152 performed bars. All notes below are CONCERT pitches.
% Bb clarinets and trumpet print up a major second; F horns up a fifth.
% Double bass prints up an octave, sounds at the stored pitch (standard E1).
% Only the layout score is transposed; MIDI uses the concert-pitch variables.
% Orchestra: 1 flute, 1 oboe, 2 Bb clarinets, 1 bassoon, 2 F horns,
% 1 Bb trumpet, 1 trombone, timpani D/A, 2 percussionists (triangle/cymbals),
% strings (suggested 6.5.4.3.2; one solo cello in the trio).
% Violas divide their two-note chords. Other sections are single lines.
% Keep every afterbeat short and buoyant; wind doubles must stay below the tune.
% Timpani pitches are A2/D3. Use a large pair; rolls are measured in the MIDI.
% Two percussionists permit the late triangle/cymbal exchange without haste.
% Compile: lilypond -dno-point-and-click -o output/pdf/lanterns-at-midnight-orchestra lanterns-at-midnight-orchestra.ly

\header {
  title = "Lanterns at Midnight"
  subtitle = "A Viennese waltz for orchestra"
  subsubtitle = "Full score in transposed notation"
  composer = "Original composition and orchestration"
  tagline = ##f
}
#(set-global-staff-size 15)
\paper {
  #(set-paper-size "a3")
  top-margin = 12\mm
  bottom-margin = 12\mm
  left-margin = 15\mm
  right-margin = 12\mm
  indent = 27\mm
  short-indent = 15\mm
  ragged-last-bottom = ##f
  print-page-number = ##t
  system-system-spacing.basic-distance = #16
  system-system-spacing.minimum-distance = #12
  oddHeaderMarkup = \markup \unless \on-first-page
    \fill-line { \small "Lanterns at Midnight - orchestra" \fromproperty #'page:page-number-string }
  evenHeaderMarkup = \markup \unless \on-first-page
    \fill-line { \fromproperty #'page:page-number-string \small "Lanterns at Midnight - orchestra" }
}

