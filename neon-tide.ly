% ---------------------------------------------------------------- full score
\book {
  \bookOutputSuffix "score"
  \paper {
    #(set-paper-size "a4")
    top-margin = 10\mm
    bottom-margin = 10\mm
    left-margin = 12\mm
    right-margin = 10\mm
    indent = 20\mm
    short-indent = 9\mm
    print-page-number = ##t
    ragged-last-bottom = ##t
    system-system-spacing.basic-distance = #14
    system-system-spacing.padding = #4
    oddHeaderMarkup = \markup \fill-line {
      \unless \on-first-page \small "Neon Tide - score"
      \unless \on-first-page \fromproperty #'page:page-number-string
    }
    evenHeaderMarkup = \oddHeaderMarkup
  }
  \score {
    \simultaneous {
      \new ChordNames \with {
        chordNameExceptions = #chExceptions
      } \simultaneous { \marks \breaks \chordNamesMusic }

      \new Staff = "alto" \with {
        instrumentName = \markup \center-column { "Alto Sax" \concat { "in E" \flat } }
        shortInstrumentName = "A. Sx."
      } { \transposition ees \transpose ees c' \simultaneous { \global \altoMusic } }

      \new Staff = "brass" \with {
        instrumentName = \markup \center-column { "Brass" "(concert)" }
        shortInstrumentName = "Br."
      } \simultaneous { \global \brassMusic }

      \new Staff = "guitar" \with {
        instrumentName = \markup \center-column { "Electric" "Guitar" }
        shortInstrumentName = "Gtr."
      } { \clef "treble_8" \simultaneous { \global \guitarMusic } }

      \new PianoStaff \with {
        instrumentName = "Rhodes"
        shortInstrumentName = "Rh."
      } \simultaneous {
        \new Staff = "rhodesUp" \simultaneous { \global \rhodesRH }
        \new Staff = "rhodesDown" { \clef bass \simultaneous { \global \rhodesLH } }
      }

      \new Staff = "strings" \with {
        instrumentName = "Strings"
        shortInstrumentName = "Str."
      } \simultaneous { \global \stringsMusic }

      \new Staff = "bass" \with {
        instrumentName = \markup \center-column { "Electric" "Bass" }
        shortInstrumentName = "Bass"
      } { \clef "bass_8" \simultaneous { \global \bassMusic } }

      \new DrumStaff \with {
        instrumentName = "Drums"
        shortInstrumentName = "Dr."
      } \simultaneous {
        \new DrumVoice { \voiceOne \drumsUp }
        \new DrumVoice { \voiceTwo \drumsDown }
      }
    }
    \layout {
      #(layout-set-staff-size 15)
      \context {
        \Staff
        \RemoveEmptyStaves
        \override VerticalAxisGroup.remove-first = ##t
      }
      \context {
        \Score
        \override SpacingSpanner.common-shortest-duration = #(ly:make-moment 1/16)
        \override NonMusicalPaperColumn.line-break-permission = ##f
        \override RehearsalMark.self-alignment-X = #LEFT
      }
    }
  }

  % MIDI at concert pitch
  \score {
    \simultaneous {
      \new Staff \with {
        midiInstrument = "alto sax"
        midiMinimumVolume = #0.55 midiMaximumVolume = #1.0
        midiPanPosition = #0.1
      } \simultaneous { \global \marks \altoMusic }
      \new Staff \with {
        midiInstrument = "brass section"
        midiMinimumVolume = #0.4 midiMaximumVolume = #0.85
        midiPanPosition = #-0.35
      } \simultaneous { \global \brassMusic }
      \new Staff \with {
        midiInstrument = "electric guitar (clean)"
        midiMinimumVolume = #0.3 midiMaximumVolume = #0.7
        midiPanPosition = #0.45
      } \simultaneous { \global \guitarMusic }
      \new Staff \with {
        midiInstrument = "electric piano 1"
        midiMinimumVolume = #0.35 midiMaximumVolume = #0.75
        midiPanPosition = #-0.2
      } \simultaneous { \global \rhodesRH }
      \new Staff \with {
        midiInstrument = "electric piano 1"
        midiMinimumVolume = #0.35 midiMaximumVolume = #0.7
        midiPanPosition = #-0.2
      } \simultaneous { \global \rhodesLH }
      \new Staff \with {
        midiInstrument = "string ensemble 1"
        midiMinimumVolume = #0.25 midiMaximumVolume = #0.6
        midiPanPosition = #0.3
      } \simultaneous { \global \stringsMusic }
      \new Staff \with {
        midiInstrument = "electric bass (finger)"
        midiMinimumVolume = #0.55 midiMaximumVolume = #0.9
      } \simultaneous { \global \bassMusic }
      \new DrumStaff \with {
        midiMinimumVolume = #0.4 midiMaximumVolume = #0.85
      } \simultaneous {
        \new DrumVoice \drumsUp
        \new DrumVoice \drumsDown
      }
    }
    \midi { }
  }
}

