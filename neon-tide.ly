    left-margin = 15\mm
    right-margin = 15\mm
    indent = 0\mm
    print-page-number = ##t
    ragged-last-bottom = ##t
    system-system-spacing = #'((basic-distance . 12) (minimum-distance . 8) (padding . 2.5) (stretchability . 12))
    markup-system-spacing.padding = #2
    max-systems-per-page = #9
    oddHeaderMarkup = \markup \fill-line {
      \unless \on-first-page \small \concat { "Neon Tide - Alto Saxophone in E" \flat }
      \unless \on-first-page \fromproperty #'page:page-number-string
    }
    evenHeaderMarkup = \oddHeaderMarkup
  }
  \score {
    \simultaneous {
      \new ChordNames \with {
        chordNameExceptions = #chExceptions
      } \transpose ees c' \chordNamesPart
      \new Staff \with {
        \override MultiMeasureRest.expand-limit = #1
      } { \compressMMRests \transpose ees c' \simultaneous { \global \marks \altoMusic } }
    }
    \layout {
      #(layout-set-staff-size 17)
      \context {
        \Score
        \override RehearsalMark.self-alignment-X = #LEFT
        \override MultiMeasureRest.minimum-length = #24
      }
    }
  }
}
